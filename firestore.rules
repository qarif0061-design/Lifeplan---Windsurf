rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwnerByField() {
      return signedIn() && request.resource.data.userId == request.auth.uid;
    }

    function isOwnerExisting() {
      return signedIn() && resource.data.userId == request.auth.uid;
    }

    match /users/{userId} {
      allow read: if signedIn() && (request.auth.uid == userId || request.auth.token.email == 'shumailasahervu@gmail.com' || request.auth.token.email == 'faranh31@gmail.com');
      allow create: if signedIn() && request.auth.uid == userId;
      allow update: if signedIn() && (request.auth.uid == userId || request.auth.token.email == 'shumailasahervu@gmail.com' || request.auth.token.email == 'faranh31@gmail.com');
      allow delete: if false;
    }

    match /goals/{goalId} {
      allow read: if signedIn() && resource.data.userId == request.auth.uid;
      allow create: if isOwnerByField();
      allow update: if isOwnerExisting();
      allow delete: if isOwnerExisting();
    }

    match /checkins/{checkinId} {
      allow read: if signedIn() && resource.data.userId == request.auth.uid;
      allow create: if isOwnerByField();
      allow update: if isOwnerExisting();
      allow delete: if isOwnerExisting();
    }

    match /plans/{planId} {
      allow read: if signedIn() && resource.data.userId == request.auth.uid;
      allow create: if isOwnerByField();
      allow update: if isOwnerExisting();
      allow delete: if isOwnerExisting();
    }

    match /daily_tasks/{dayId} {
      allow read: if signedIn() && resource.data.userId == request.auth.uid;
      allow create: if isOwnerByField();
      allow update: if isOwnerExisting();
      allow delete: if isOwnerExisting();
    }

    match /weeklyPlanners/{plannerId} {
      allow read: if signedIn();
      allow create: if signedIn();
      allow update: if signedIn();
      allow delete: if signedIn();
    }

    match /customPlanners/{plannerId} {
      allow read: if signedIn();
      allow create: if signedIn();
      allow update: if signedIn();
      allow delete: if signedIn();
    }

    match /referrals/{referralId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if signedIn() && resource.data.userId == request.auth.uid;
      allow delete: if false;
    }

    match /templates/{templateId} {
      allow read: if true;
      allow create: if signedIn() && request.resource.data.authorId == request.auth.uid;
      allow update: if signedIn() && resource.data.authorId == request.auth.uid;
      allow delete: if signedIn() && resource.data.authorId == request.auth.uid;
    }

    match /accountabilities/{accId} {
      allow read: if signedIn() && (resource.data.inviterId == request.auth.uid || resource.data.partnerEmail == request.auth.token.email || resource.data.partnerId == request.auth.uid);
      allow create: if signedIn() && request.resource.data.inviterId == request.auth.uid;
      allow update: if signedIn() && (resource.data.inviterId == request.auth.uid || resource.data.partnerEmail == request.auth.token.email || resource.data.partnerId == request.auth.uid);
      allow delete: if signedIn() && (resource.data.inviterId == request.auth.uid || resource.data.partnerId == request.auth.uid);
    }
  }
}
