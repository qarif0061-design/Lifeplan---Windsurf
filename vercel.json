{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "redirects": [
    {
      "source": "/getting-things-done",
      "destination": "/articles/how-to-get-things-done-system-2026",
      "permanent": true
    },
    {
      "source": "/life-planning",
      "destination": "/articles/how-to-set-goals-and-actually-achieve-them",
      "permanent": true
    },
    {
      "source": "/time-management",
      "destination": "/articles/time-management-tips-and-strategies-2026",
      "permanent": true
    },
    {
      "source": "/smart-goals",
      "destination": "/articles/smart-goals-template-and-examples-2026",
      "permanent": true
    },
    {
      "source": "/motivation",
      "destination": "/articles/best-motivational-quotes-2026",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/.well-known/apple-app-site-association",
      "headers": [
        { "key": "Content-Type", "value": "application/json" }
      ]
    },
    {
      "source": "/.well-known/assetlinks.json",
      "headers": [
        { "key": "Content-Type", "value": "application/json" }
      ]
    }
  ]
}
